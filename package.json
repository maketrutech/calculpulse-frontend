{
  "name": "calculpulse-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "export CP_BUILD_DATE=${CP_BUILD_DATE:-$(TZ=Europe/Paris date +%F)} && vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/check-fr-unchanged.mjs",
    "check:fr": "node scripts/check-fr-unchanged.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test src/lib/*.test.js",
    "serve:lh": "node scripts/serve.mjs",
    "brand": "python3 scripts/generate-brand.py"
  },
  "dependencies": {
    "@fontsource/fragment-mono": "^5.2.8",
    "@fontsource/fraunces": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
